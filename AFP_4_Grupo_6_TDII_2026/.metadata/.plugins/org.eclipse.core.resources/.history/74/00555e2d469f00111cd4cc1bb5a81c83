/**
 * @brief Reinicia las variables locales y apaga todas las salidas.
 */
static void Reset_Secuencias_Variables(void)
{
	for (uint8_t i = 0U; i < LED_GetCount(); i++)
	{
		LED_Write(i, false);
	}

	indice_led = 0U;
	modo_sec1 = Estado_Encendido;
	estado_parpadeo_sec2 = false;
	estado_parpadeo_sec4 = false;

	/* Reinicio de temporizadores para inicio sincronizado */
	nb_delay_init(&delay_sec1, tiempo_sec1);
	nb_delay_init(&delay_sec2, tiempo_sec2);
	nb_delay_init(&delay_sec3_led0, 100U);
	nb_delay_init(&delay_sec3_led1, 300U);
	nb_delay_init(&delay_sec3_led2, 600U);
	nb_delay_init(&delay_sec4, tiempo_sec4);
}

/* USER CODE END 0 */

/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_USART3_UART_Init();
  /* USER CODE BEGIN 2 */

	/* Inicialización de controladores de Capa 2 */
	LED_Init(tabla_leds_hardware, total_leds);
	BOTON_Init(tabla_botones_hw, cant_botones);

	/* Inicialización de temporizadores y variables */
	Reset_Secuencias_Variables();

  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
	while (1)
	{
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */

		/*
		 * 1. Polling de alta velocidad del pulsador de usuario:
		 * Transiciona la MEF principal y resetea de forma segura el contexto.
		 */
		if (BOTON_DetectarFlancoPresionado(INDICE_BTN_USER))
		{
			estado_secuencia++;
			if (estado_secuencia > Secuencia_4)
			{
				estado_secuencia = Secuencia_1;
			}

			Reset_Secuencias_Variables();
		}

		/*
		 * 2. Máquina de Estados Principal (100% no bloqueante)
		 */
		switch (estado_secuencia)
		{
		case Secuencia_1:
			/* Secuencia circular paso a paso */
			if (nb_delay_read(&delay_sec1))
			{
				switch (modo_sec1)
				{
				case Estado_Encendido:
					LED_Write(indice_led, true);
					modo_sec1 = Estado_Apagado;
					break;

				case Estado_Apagado:
					LED_Write(indice_led, false);
					indice_led++;
					if (indice_led >= LED_GetCount())
					{
						indice_led = 0U;
					}
					modo_sec1 = Estado_Encendido;
					break;

				default:
					modo_sec1 = Estado_Encendido;
					indice_led = 0U;
					break;
				}
			}
			break;

		case Secuencia_2:
			/* Parpadeo síncrono general (toggle en bloque cada 300 ms) */
			if (nb_delay_read(&delay_sec2))
			{
				estado_parpadeo_sec2 = !estado_parpadeo_sec2;
				for (uint8_t j = 0U; j < LED_GetCount(); j++)
				{
					LED_Write(j, estado_parpadeo_sec2);
				}
			}
			break;

		case Secuencia_3:
			/* Parpadeo asincrónico independiente por LED */
			if (nb_delay_read(&delay_sec3_led0))
			{
				LED_Toggle(0U); // LED 0 conmuta cada 100 ms
			}
			if (nb_delay_read(&delay_sec3_led1))
			{
				LED_Toggle(1U); // LED 1 conmuta cada 300 ms
			}
			if (nb_delay_read(&delay_sec3_led2))
			{
				LED_Toggle(2U); // LED 2 conmuta cada 600 ms
			}
			break;

		case Secuencia_4:
			/* Parpadeo cruzado en antifase cada 300 ms */
			if (nb_delay_read(&delay_sec4))
			{
				estado_parpadeo_sec4 = !estado_parpadeo_sec4;

				/* LED 0 y 2 en fase directa / LED 1 en contrafase */
				LED_Write(0U, estado_parpadeo_sec4);
				LED_Write(2U, estado_parpadeo_sec4);
				LED_Write(1U, !estado_parpadeo_sec4);
			}
			break;

		default:
			/* Recuperación defensiva ante fallas de memoria */
			estado_secuencia = Secuencia_1;
			Reset_Secuencias_Variables();
			break;
		}
	}
  /* USER CODE END 3 */
}

